# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
DATABASE_URL=postgresql://salon:salon@localhost:5432/salon

# Long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
CODE_SECRET=change-me-to-another-long-random-string

# Comma-separated list of web origins allowed to call the API (Flutter web /
# admin pages). Mobile and desktop apps do not need an entry.
CORS_ORIGINS=http://localhost:3000

# Email for sign-up and login codes (any SMTP provider: Resend, Brevo, Gmail).
# Resend: host smtp.resend.com, port 465, user "resend", password = API key.
# Leave SMTP_HOST empty in development to print codes to the server log.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Salon Finder <no-reply@yourdomain.com>"

# Razorpay (optional). Without keys, online payment is switched off and
# customers pay at the salon.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Claude assistant (optional). Without a key, /assistant/chat returns 503.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
